{
  "name": "pp3-spotify",
  "version": "1.0.0",
  "engines": {
    "node": "20.18.0"
  },
  "scripts": {
    "install-reactjs": "npm install --prefix frontend",
    "install-backend": "npm install --prefix backend",
    "build-reactjs": "npm run build --prefix frontend",
    "build": "concurrently \"npm:install-*\"; concurrently \"npm:build-*\"; ",
    "start": "npm start --prefix backend",
    "dev:react": "concurrently --raw \"npm run backend\" \"npm run react\"",
    "react": "cd frontend && npm run dev",
    "backend": "cd backend && npm run dev"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
